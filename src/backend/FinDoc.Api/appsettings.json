{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Embeddings": {
    "Provider": "Fake",
    "Dimensions": 1536,
    "BatchSize": 32,
    "WorkerEnabled": true
  },
  "Answers": {
    "Provider": "Fake",
    "MinimumRelevanceScore": 0.1,
    "MaxQuestionLength": 1000,
    "MaxPassages": 8,
    "MaxAnswerLength": 1000,
    "Timeout": "00:00:30"
  },
  "History": {
    "RetentionDays": 90,
    "MaxPageSize": 100,
    "CleanupInterval": "01:00:00",
    "WorkerEnabled": true
  },
  "AllowedHosts": "*"
}
